{
  "id": "short-02-moyenne-ment",
  "rubrique": "Le radar",
  "eyebrow": "Le radar",
  "note": "Exemple illustratif",
  "audio": null,
  "segments": [
    {
      "expr": "think",
      "text": "Votre outil affiche : position moyenne, quatre. Rassurant ? Pas forcément.",
      "card": {
        "kind": "map",
        "mode": "average"
      },
      "pose": {
        "rpose": "rest"
      }
    },
    {
      "expr": "explain",
      "text": "Cette moyenne mélange les rues où vous êtes premier, et celles où personne ne vous voit.",
      "card": {
        "kind": "map",
        "mode": "spread",
        "sticker": "1 ou 20+ selon la rue",
        "color": "#4f46e5"
      },
      "pose": {
        "rpose": "point"
      }
    },
    {
      "expr": "worried",
      "text": "Or votre client ne voit jamais de moyenne. Il voit trois fiches : celles de sa rue.",
      "card": {
        "kind": "pack",
        "sticker": "3 fiches, pas de moyenne"
      },
      "pose": {
        "count": 3
      }
    },
    {
      "expr": "explain",
      "text": "Ce qu'il vous faut, c'est une carte : un point par quartier, et votre rang sur chacun.",
      "card": {
        "kind": "map",
        "mode": "grid",
        "sticker": "1 point = 1 quartier",
        "color": "#4f46e5"
      },
      "pose": {
        "rpose": "point"
      }
    },
    {
      "expr": "wow",
      "text": "Là où la carte s'éteint, vous savez enfin où agir : la fiche, un post, un article.",
      "card": {
        "kind": "map",
        "mode": "hole",
        "sticker": "Ici, on agit"
      },
      "pose": {
        "rpose": "point"
      }
    },
    {
      "expr": "happy",
      "text": "Voyez votre propre carte : l'audit est gratuit, lien en bio.",
      "card": {
        "kind": "cta",
        "title": "Audit gratuit",
        "label": "Lien en bio ↗"
      },
      "pose": {
        "rpose": "wave"
      }
    }
  ]
}